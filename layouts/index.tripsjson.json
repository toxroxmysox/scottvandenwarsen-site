{{- /* Validate gallery paths at build time */ -}}
{{- range $trip := .Site.Data.trips -}}
  {{- if $trip.gallery -}}
    {{- $page := site.GetPage $trip.gallery -}}
    {{- if not $page -}}
      {{- warnf "trips.yaml: trip '%s' references gallery '%s' which does not exist" $trip.id $trip.gallery -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
[{{ range $i, $trip := .Site.Data.trips }}{{ if $i }},{{ end }}
  {
    "id": {{ $trip.id | jsonify }},
    "title": {{ $trip.title | jsonify }},
    "description": {{ $trip.description | default "" | jsonify }},
    "country_codes": {{ $trip.country_codes | jsonify }},
    "flag": {{ index site.Data.country_flags (index $trip.country_codes 0) | default "" | jsonify }},
    "trip_start": {{ $trip.trip_start | jsonify }},
    "trip_end": {{ $trip.trip_end | jsonify }},
    "gallery": {{ $trip.gallery | default "" | jsonify }}
  }{{ end }}
]
